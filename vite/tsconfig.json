{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The one package allowed `node:fs`. That permission is the whole reason it is
    // a separate package rather than a folder inside react/.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
