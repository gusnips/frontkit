{
  "name": "frontkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "tokens",
    "http",
    "react",
    "vite"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint tokens http react vite",
    "purity": "bun run scripts/check-purity.ts",
    "exports": "bun run scripts/check-exports.ts",
    "release:check": "bun run scripts/check-release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run purity && bun run exports && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.2"
  }
}
