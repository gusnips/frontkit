{
  "name": "@gusnips/react",
  "version": "0.9.20",
  "description": "The headless runtime under a Vite + React SPA: typed fetch client with single-flight refresh, auth store, query defaults, route guards, error boundary, stale-tab recovery, i18n bootstrap.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "homepage": "https://github.com/gusnips/frontkit/tree/main/react#readme",
  "bugs": {
    "url": "https://github.com/gusnips/frontkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./store": {
      "types": "./dist/auth-store.d.ts",
      "default": "./dist/auth-store.js"
    },
    "./supabase": {
      "types": "./dist/supabase-session.d.ts",
      "default": "./dist/supabase-session.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "default": "./dist/guards.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "default": "./dist/hydrate.js"
    },
    "./contract": {
      "types": "./dist/prerender-contract.d.ts",
      "default": "./dist/prerender-contract.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "vite",
    "spa",
    "zustand",
    "react-query",
    "i18next",
    "base-ui",
    "headless"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build && bun run sync:docs",
    "release:patch": "bun pm version patch && bun publish --access public",
    "release:minor": "bun pm version minor && bun publish --access public",
    "release:major": "bun pm version major && bun publish --access public"
  },
  "dependencies": {
    "@gusnips/http": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "i18next": ">=25",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": ">=16",
    "react-router-dom": "^7",
    "zustand": "^5"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/frontkit.git",
    "directory": "react"
  }
}
